From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kacimiamine <contact@kacimiamine.com>
Date: Thu, 30 Jul 2026 19:31:28 +0100
Subject: [PATCH] Breedable mobs can have multiple babies


diff --git a/net/minecraft/world/entity/Mob.java b/net/minecraft/world/entity/Mob.java
index 963eb0e38011e37f8a3f20751bcf47c184623ed7..44e8da8b46661721acb52d44dba926f69b021e44 100644
--- a/net/minecraft/world/entity/Mob.java
+++ b/net/minecraft/world/entity/Mob.java
@@ -155,6 +155,7 @@ public abstract class Mob extends LivingEntity implements Targeting, EquipmentUs
     private int homeRadius = -1;
     public boolean aware = true; // CraftBukkit
     public int ticksSinceLastInteraction; // Purpur - Entity lifespan
+    protected boolean willHaveAnotherBaby() { return false; } protected int getBreedingMinOffspring() { return 1; } protected int getBreedingMaxOffspring() { return 1; } // Purpur - Breedable mobs can have multiple babies
 
     protected Mob(final EntityType<? extends Mob> type, final Level level) {
         super(type, level);
diff --git a/net/minecraft/world/entity/ai/behavior/VillagerMakeLove.java b/net/minecraft/world/entity/ai/behavior/VillagerMakeLove.java
index 9aefa11fcc336c5c98c63301b7f9a51b397bdc71..350cfa051d0a12d596efd041ff36ad89270b75cf 100644
--- a/net/minecraft/world/entity/ai/behavior/VillagerMakeLove.java
+++ b/net/minecraft/world/entity/ai/behavior/VillagerMakeLove.java
@@ -107,6 +107,13 @@ public class VillagerMakeLove extends Behavior<Villager> {
     }
 
     private Optional<Villager> breed(final ServerLevel level, final Villager source, final Villager target) {
+        // Purpur start - Breedable mobs can have multiple babies
+        return this.breed(level, source, target, 0);
+    }
+
+    private Optional<Villager> breed(final ServerLevel level, final Villager source, final Villager target, int currentBabyCount) {
+        if ((currentBabyCount >= source.getBreedingMinOffspring()) && (!source.willHaveAnotherBaby() || currentBabyCount >= source.getBreedingMaxOffspring())) return Optional.empty();
+        // Purpur end - Breedable mobs can have multiple babies
         Villager child = source.getBreedOffspring(level, target);
         if (child == null) {
             return Optional.empty();
@@ -126,6 +133,7 @@ public class VillagerMakeLove extends Behavior<Villager> {
         level.addFreshEntityWithPassengers(child, org.bukkit.event.entity.CreatureSpawnEvent.SpawnReason.BREEDING);
         // CraftBukkit end - call EntityBreedEvent
         level.broadcastEntityEvent(child, EntityEvent.LOVE_HEARTS);
+        this.breed(level, source, target, currentBabyCount + 1); // Purpur - Breedable mobs can have multiple babies
         return Optional.of(child);
     }
 
diff --git a/net/minecraft/world/entity/animal/Animal.java b/net/minecraft/world/entity/animal/Animal.java
index 066bec0f5ed154dea08287ff6d4653a4623f956a..2f406344234508907e6bc6632b2bc70d24b4b6e3 100644
--- a/net/minecraft/world/entity/animal/Animal.java
+++ b/net/minecraft/world/entity/animal/Animal.java
@@ -226,6 +226,13 @@ public abstract class Animal extends AgeableMob {
     }
 
     public void spawnChildFromBreeding(final ServerLevel level, final Animal partner) {
+        // Purpur start - Breedable mobs can have multiple babies
+        this.spawnChildFromBreeding(level, partner, 0);
+    }
+
+    public void spawnChildFromBreeding(final ServerLevel level, final Animal partner, int currentBabyCount) {
+        if ((currentBabyCount >= getBreedingMinOffspring()) && (!willHaveAnotherBaby() || currentBabyCount >= getBreedingMaxOffspring())) return;
+        // Purpur end - Breedable mobs can have multiple babies
         AgeableMob offspring = this.getBreedOffspring(level, partner);
         if (offspring != null) {
             //offspring.setBaby(true); // Purpur - Add adjustable breeding cooldown to config - moved down
@@ -254,6 +261,7 @@ public abstract class Animal extends AgeableMob {
             this.finalizeSpawnChildFromBreeding(level, partner, offspring, experience);
             level.addFreshEntityWithPassengers(offspring, org.bukkit.event.entity.CreatureSpawnEvent.SpawnReason.BREEDING);
             // CraftBukkit end - Call EntityBreedEvent
+            this.spawnChildFromBreeding(level, partner, currentBabyCount + 1); // Purpur - Breedable mobs can have multiple babies
         }
     }
 
