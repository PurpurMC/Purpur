+    // Purpur start - Breedable mobs can have multiple babies
+    @Override
+    protected boolean willHaveAnotherBaby() {
+        return (this.level().purpurConfig.armadilloBreedingChance > 0.0D) && (this.level().purpurConfig.armadilloBreedingChance >= this.random.nextDouble());
+    }
