@@ -74,6 +78,67 @@ public class LightningBolt extends Entity {
         }
     }
 
+    // Purpur start - lightning transforms blocks
+    public void initBlocks() {
+        this.blocks = this.getTransformedBlocks();
+    }
+
+    private List<org.bukkit.craftbukkit.block.CraftBlockState> getTransformedBlocks() {
+        if (!level().purpurConfig.lightningTransformsBlocks) return new java.util.ArrayList<>();
+
+        BlockPos blockposition = this.getStrikePosition();
+        BlockState iblockdata = this.level().getBlockState(blockposition);
+        BlockPos pos;
+        BlockState iblockdata2;
+
+        if (iblockdata.is(net.minecraft.world.level.block.Blocks.LIGHTNING_ROD)) {
+            pos = blockposition.below();
+            iblockdata2 = this.level().getBlockState(pos);
+        } else {
+            iblockdata2 = iblockdata;
+            pos = blockposition;
+        }
+
+        java.util.Map<net.minecraft.world.level.block.Block, BlockState> transformMap = level().purpurConfig.lightningBlockTransformMap;
+        org.bukkit.craftbukkit.util.BlockStateListPopulator blockList = new org.bukkit.craftbukkit.util.BlockStateListPopulator(level());
+
+        BlockState targetState = transformMap.get(iblockdata2.getBlock());
+        if (targetState != null) {
+            blockList.setBlock(pos, targetState, 2);
+        }
+
+        if (!level().purpurConfig.lightningTransformsNearbyBlocks) {
+            return blockList.getSnapshotBlocks();
+        }
+        BlockPos.breadthFirstTraversal(
+                pos,
+                level().purpurConfig.lightningNearbyBlocksMaxDepth,
+                level().purpurConfig.lightningNearbyBlocksMaxIterations,
+                (validPos, queueAdder) -> {
+                    for (net.minecraft.core.Direction direction : net.minecraft.core.Direction.values()) {
+                        queueAdder.accept(validPos.relative(direction));
+                    }
+                },
+        blockPos -> {
+                    if (blockPos.equals(pos)) {
+                        return BlockPos.TraversalNodeStatus.ACCEPT;
+                    } else {
+                        BlockState nearbyState = blockList.getBlockState(blockPos);
+                        BlockState nearbyTarget = transformMap.get(nearbyState.getBlock());
+                        if (nearbyTarget == null) {
+                            return BlockPos.TraversalNodeStatus.SKIP;
+                        } else {
+                            blockList.setBlock(blockPos, nearbyTarget, 3);
+                            return BlockPos.TraversalNodeStatus.ACCEPT;
+                        }
+                    }
+                }
+            );
+
+        return blockList.getSnapshotBlocks();
+    }
+    // Purpur end - lightning transforms blocks
+
     @Override
     public void tick() {
         super.tick();
@@ -108,6 +173,7 @@ public class LightningBolt extends Entity {
                 }
 
                 this.powerLightningRod();
