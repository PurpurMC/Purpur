     public Optional<StructureTemplate> get(final Identifier id) {
-        return this.structureRepository.computeIfAbsent(id, this::tryLoad);
+        // Purpur start - support GameTest exports
+        // return this.structureRepository.computeIfAbsent(id, this::tryLoad);
+        Optional<StructureTemplate> cached = this.structureRepository.get(id);
+        if (cached != null && cached.isPresent()) {
+            return cached;
+        }
+
+        Optional<StructureTemplate> loaded = this.tryLoad(id);
+        if (loaded.isPresent()) {
+            this.structureRepository.put(id, loaded);
+        } else {
+            this.structureRepository.put(id, Optional.empty());
+        }
+        return loaded;
     }
 
