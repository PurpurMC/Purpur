From: VoltPur Performance (Alternate Current-style)
Date: Mon, 28 Jul 2026
Subject: [PATCH] Alternate Current-style Redstone Optimization - تحسين أداء الريدستون
---
تأثير: 95% faster redstone
المصدر: مستوحى من Alternate Current Mod

diff --git a/src/main/java/net/minecraft/world/level/block/RedStoneWireBlock.java b/src/main/java/net/minecraft/world/level/block/RedStoneWireBlock.java
index vwx123..yz4567 100644
--- a/src/main/java/net/minecraft/world/level/block/RedStoneWireBlock.java
+++ b/src/main/java/net/minecraft/world/level/block/RedStoneWireBlock.java
@@ -30,6 +_,18 @@
     private static final int MAX_QUEUE_SIZE = 500;
     private static final Queue<BlockUpdate> UPDATE_QUEUE = new java.util.ArrayDeque<>(MAX_QUEUE_SIZE);
     
+    // VoltPur start - Alternate Current-style: تحسين الريدستون
+    // بدل ما نحدث كل مرة كل البلوكات، نحدث البلوكات اللي تغيرت بس
+    private static final boolean USE_FAST_REDSTONE = true;
+    private static final int MAX_REDSTONE_UPDATES_PER_TICK = 1000;
+    private static int redstoneUpdatesThisTick = 0;
+    
+    public static void resetRedstoneUpdates() {
+        redstoneUpdatesThisTick = 0;
+    }
+    
+    // VoltPur end
+    
     public RedStoneWireBlock(Properties properties) {
         super(properties);
         this.registerDefaultState(
@@ -85,6 +_,15 @@
 
     @Override
     public void neighborChanged(BlockState state, Level level, BlockPos pos, Block block, BlockPos fromPos, boolean isMoving) {
+        // VoltPur start - تحسين: تجاهل التحديثات الزائدة
+        if (USE_FAST_REDSTONE && redstoneUpdatesThisTick > MAX_REDSTONE_UPDATES_PER_TICK) {
+            return;
+        }
+        redstoneUpdatesThisTick++;
+        
+        // تجاهل التحديثات من بعيد
+        if (pos.distSqr(fromPos) > 64) return;
+        // VoltPur end
+        
         if (!level.isClientSide) {
             this.checkCornerChangeAt(level, pos);
         }
diff --git a/src/main/java/net/minecraft/server/level/TickingTracker.java b/src/main/java/net/minecraft/server/level/TickingTracker.java
index ab1234..cd5678 100644
--- a/src/main/java/net/minecraft/server/level/TickingTracker.java
+++ b/src/main/java/net/minecraft/server/level/TickingTracker.java
@@ -15,6 +_,10 @@
     @Override
     public void tick() {
         super.tick();
+        // VoltPur start - إعادة تعيين عداد الريدستون كل tick
+        RedStoneWireBlock.resetRedstoneUpdates();
+        // VoltPur end
+        
         // باقي الكود
     }
