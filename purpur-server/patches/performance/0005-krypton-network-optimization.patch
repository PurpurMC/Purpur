diff --git a/src/main/java/net/minecraft/server/network/ServerGamePacketListenerImpl.java b/src/main/java/net/minecraft/server/network/ServerGamePacketListenerImpl.java
index jkl012..mno345 100644
--- a/src/main/java/net/minecraft/server/network/ServerGamePacketListenerImpl.java
+++ b/src/main/java/net/minecraft/server/network/ServerGamePacketListenerImpl.java
@@ -45,6 +_,12 @@
     private int receivedMovePackets;
     private long lastPacketReceipt;
 
+    // VoltPur start - Krypton-style: تقليل معالجة البكتات غير الضرورية
+    private static final long MIN_PACKET_INTERVAL = 1000000L; // 1ms between same-type packets
+    private long lastKeepAlivePacket;
+    private long lastMovePacket;
+    // VoltPur end
+    
     public ServerGamePacketListenerImpl(MinecraftServer server, Connection connection, ServerPlayer player, CommonListenerCookie cookie) {
         super(server, connection, player, cookie);
         this.lastPacketReceipt = MonotonicClockSource.INSTANCE.now();
@@ -120,6 +_,16 @@
     @Override
     public void handleMovePlayer(ServerboundMovePlayerPacket packet) {
         super.handleMovePlayer(packet);
+        // VoltPur start - تحسين: تجاهل حركات اللاعب المتكررة
+        long now = System.nanoTime();
+        if (packet.hasPosition() && packet.hasRotation()) {
+            if (now - this.lastMovePacket < MIN_PACKET_INTERVAL) {
+                packet.setCancelled(true);
+                return;
+            }
+            this.lastMovePacket = now;
+        }
+        // VoltPur end
         this.lastPacketReceipt = MonotonicClockSource.INSTANCE.now();
         this.lastPosition = this.player.position();
     }
