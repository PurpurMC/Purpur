+    // بدل ما نعمل AABB check لكل الكائنات، نعمل تحقق سريع أولاً
+    private static final double COLLISION_CACHE_RADIUS = 2.0;
+    private long lastCollisionCacheUpdate = 0;
+    private boolean collisionCacheValid = false;
