         this.level = level;
+        
+        // VoltPur start - تحسين الذاكرة: استخدام HashMap بحجم مبدئي صغير
+        this.blockEntities = new java.util.HashMap<>(Math.min(32, Math.max(4, sections != null ? sections.length / 4 : 4)));
+        this.tickingBlockEntities = new java.util.ArrayList<>(0);
+        
+        // تحسين: عدم تخزين blockEntities لو القطعة جديدة وفاضية
+        if (sections == null || sections.length == 0) {
+            this.blockEntities = java.util.Collections.emptyMap();
+        } else {
+            this.blockEntities = new java.util.HashMap<>(16);
+        }
+        // VoltPur end
