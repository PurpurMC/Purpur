 package net.minecraft.server.network;
 
+// VoltPur start - Bedrock Bridge: تحسين حركة Bedrock
+/**
+ * تحسين معالجة حركة اللاعب للـ Bedrock:
+ * - التسامح في الحركة 2.5x للـ Bedrock
+ * - استعادة تلقائية للموقع عند فقدان البكتات
+ * - منع الكيك للحركة غير الصالحة بسبب ping عالي
+ * 
+ * النظام يعتمد على ServerCommonPacketListenerImpl.getActiveMovementTolerance()
+ */
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.LinkedList;
+
+/**
+ * التدفق:
+ * Bedrock Player → حركة غير منتظمة → [Movement Buffer] → تحقق موسع → قبول/تصحيح
+ *                                  ↕
+ *                          [آخر موقع صحيح]
+ *                                  ↕
+ *                          لو ping عالي → نعدل الموقع
+ *                          لو فقدان بكتات → نسترجع آخر موقع
+ */
+import net.minecraft.world.phys.Vec3;
+
 public class ServerGamePacketListenerImpl extends ServerCommonPacketListenerImpl {
     private static final Logger LOGGER = LogUtils.getLogger();
     private static final long MOVEMENT_TIMEOUT = 5000L;
@@ -10,6 +_,77 @@
     private static final double MAX_MOVEMENT_DIFF = 100.0;
     private static final double TUNNEL_MOVEMENT_TOLERANCE = 150.0;
     
+    // VoltPur start - Bedrock Bridge: نظام حركة متكيف
+    // =====================================================
+    // 1. مخزن مؤقت لمواقع اللاعب (للرجوع عند فقدان بكتات)
+    private final LinkedList<PositionSnapshot> positionHistory = new LinkedList<>();
+    private static final int MAX_POSITION_HISTORY = 20; // آخر 20 موقع (ثانية واحدة)
+    
+    private static class PositionSnapshot {
+        final double x, y, z;
+        final float yaw, pitch;
+        final long time;
+        
+        PositionSnapshot(double x, double y, double z, float yaw, float pitch) {
+            this.x = x; this.y = y; this.z = z;
+            this.yaw = yaw; this.pitch = pitch;
+            this.time = System.currentTimeMillis();
+        }
+    }
+    
+    // 2. إحصائيات الحركة
+    private int totalMovements = 0;
+    private int acceptedMovements = 0;
+    private int correctedMovements = 0;
+    private int rejectedMovements = 0;
+    private double lastValidX, lastValidY, lastValidZ;
+    private float lastValidYaw, lastValidPitch;
+    
+    // 3. خريطة للبكتات المعلقة (sequence-based)
+    private final Map<Integer, Long> pendingMovePackets = new ConcurrentHashMap<>();
+    private int lastProcessedSequence = 0;
+    
+    /**
+     * يعيد إحصائيات الحركة للتقرير.
+     */
+    public String getMovementStats() {
+        int total = acceptedMovements + correctedMovements + rejectedMovements;
+        double acceptanceRate = total == 0 ? 100.0 : (acceptedMovements * 100.0 / total);
+        return String.format(
+            "§7Movements: §a%d accepted §e%d corrected §c%d rejected §7(§f%.1f%%§7 ok)",
+            acceptedMovements, correctedMovements, rejectedMovements, acceptanceRate
+        );
+    }
+    
+    /**
+     * يسجل موقع اللاعب الحالي في التاريخ.
+     */
+    private void recordPosition(double x, double y, double z, float yaw, float pitch) {
+        this.lastValidX = x; this.lastValidY = y; this.lastValidZ = z;
+        this.lastValidYaw = yaw; this.lastValidPitch = pitch;
+        
+        this.positionHistory.addLast(new PositionSnapshot(x, y, z, yaw, pitch));
+        while (this.positionHistory.size() > MAX_POSITION_HISTORY) {
+            this.positionHistory.pollFirst();
+        }
+    }
+    
+    /**
+     * يستعيد آخر موقع صحيح للاعب.
+     */
+    private void restoreLastValidPosition() {
+        if (!this.positionHistory.isEmpty()) {
+            PositionSnapshot last = this.positionHistory.getLast();
+            this.player.teleportTo(last.x, last.y, last.z);
+            this.player.setYRot(last.yaw);
+            this.player.setXRot(last.pitch);
+            LOGGER.info("[BedrockBridge] 🔄 Restored position for {} to ({:.1f}, {:.1f}, {:.1f})",
+                this.player.getScoreboardName(), last.x, last.y, last.z);
+        }
+    }
+    
+    /**
+     * يعيد tolerance الحركة حسب نوع الاتصال.
+     */
+    private double getEffectiveMovementTolerance() {
+        return MAX_MOVEMENT_DIFF * this.getActiveMovementTolerance();
+    }
+    // VoltPur end
+    
     @Override
     public void handleMovePlayer(ServerboundMovePlayerPacket packet) {
-        // منطق معالجة الحركة الأصلي
