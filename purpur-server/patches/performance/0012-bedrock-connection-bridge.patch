+        // VoltPur start - Bedrock Bridge: وقت تسجيل أطول
+        if (this.isBedrockLogin) {
+            // Bedrock يحتاج وقت أطول للتسجيل
+            long elapsed = System.currentTimeMillis() - this.loginStartTime;
+            if (elapsed > LOGIN_TIMEOUT && elapsed < BEDROCK_LOGIN_TIMEOUT) {
