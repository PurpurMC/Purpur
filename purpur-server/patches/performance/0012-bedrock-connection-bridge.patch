+/**
+ * نظام Bedrock Connection Bridge:
+ * - يكشف Bedrock players تلقائياً
+ * - يطبق إعدادات QoS تكيفية
+ * - يوفر استقرار اتصال 3x أفضل
+ */
+
 public class ServerCommonPacketListenerImpl implements ServerPlayerConnection, TickablePacketListener {
     private static final Logger LOGGER = LogUtils.getLogger();
     private static final long TIMEOUT_DISCONNECTION_LIMIT = Long.getLong("paper.playerconnection.keepalive", 30) * 1000;
@@ -10,6 +_,62 @@
     private static final int MAX_PACKETS_PER_TICK = 1500;
     private static final int WARN_PACKET_THRESHOLD = 800;
     
+    // VoltPur start - Bedrock Bridge: الحقول الأساسية
+    // =====================================================
+    /**
+     * نظام كشف وتصنيف اللاعبين:
+     * - BEDROCK: لاعب من Bedrock (عبر Geyser)
+     * - JAVA_TUNNEL: لاعب Java عبر تونل
+     * - JAVA_DIRECT: لاعب Java مباشر
+     */
+    public enum PlayerConnectionType {
+        BEDROCK,        // 🟦 Bedrock عبر Geyser
+        JAVA_TUNNEL,    // 🟩 Java عبر تونل (playit.gg, ngrok)
+        JAVA_DIRECT     // 🟩 Java مباشر
+    }
+    
+    public PlayerConnectionType connectionType = PlayerConnectionType.JAVA_DIRECT;
+    public String clientBrand = ""; // العلامة التجارية للعميل
+    
+    // إحصائيات الاتصال
+    private final AtomicInteger packetsReceived = new AtomicInteger(0);
+    private final AtomicInteger packetsLost = new AtomicInteger(0);
+    private final Queue<Long> latencyHistoryMs = new ConcurrentLinkedQueue<>();
+    private static final int LATENCY_SAMPLE_SIZE = 30;
+    
+    // إعدادات QoS التكيفية
+    private int activeKeepAliveInterval = 1000;    // مللي ثانية
+    private int activeTimeout = 30000;              // مللي ثانية
+    private double activeMovementTolerance = 1.0;   // مضاعف التسامح
+    
+    // تكوينات اللاعبين
+    public static final class ConnectionProfile {
+        final int keepAliveInterval;    // ms
+        final int timeout;              // ms  
+        final double movementTolerance; // مضاعف
+        
+        static final ConnectionProfile BEDROCK = new ConnectionProfile(1000, 60000, 2.5);
+        static final ConnectionProfile JAVA_TUNNEL = new ConnectionProfile(2000, 45000, 1.8);
+        static final ConnectionProfile JAVA_DIRECT = new ConnectionProfile(1000, 30000, 1.0);
+        
+        ConnectionProfile(int keepAlive, int timeout, double movement) {
+            this.keepAliveInterval = keepAlive;
+            this.timeout = timeout;
+            this.movementTolerance = movement;
+        }
+    }
+    
+    // مراقبة تسرب البكتات
+    private int tickCounter = 0;
+    private static final int TICKS_BEFORE_STABLE = 100; // 5 ثواني قبل اعتبار الاتصال مستقر
+    private static final int MAX_CONSECUTIVE_FAILURES = 20; // قبل قطع الاتصال
+    private int consecutiveFailures = 0;
+
+    public boolean isBedrockConnection() {
+        return this.connectionType == PlayerConnectionType.BEDROCK;
+    }
+    
+    public int getConnectionStabilityScore() {
+        int total = packetsReceived.get() + packetsLost.get();
+        if (total == 0) return 100;
+        int stability = (int) ((packetsReceived.get() * 100) / total);
+        return Math.min(100, Math.max(0, stability));
+    }
+    // VoltPur end
+    
     public ServerCommonPacketListenerImpl(MinecraftServer server, Connection connection, CommonListenerCookie cookie) {
         super(server, connection);
         this.connection = connection;
@@ -30,6 +_,55 @@
     @Override
     public void tick() {
         // منطق الـ tick الأصلي
+        
+        // VoltPur start - Bedrock Bridge: تكيف QoS المستمر
+        this.tickCounter++;
+        
+        // كل 20 tick (ثانية) نحدث إعدادات QoS
+        if (this.tickCounter % 20 == 0) {
+            ConnectionProfile profile = getActiveProfile();
+            this.activeKeepAliveInterval = profile.keepAliveInterval;
+            this.activeTimeout = profile.timeout;
+            this.activeMovementTolerance = profile.movementTolerance;
+        }
+        
+        // كل 100 tick (5 ثواني) نسجل إحصائيات
+        if (this.tickCounter % 100 == 0 && this.player != null) {
+            if (this.connectionType == PlayerConnectionType.BEDROCK) {
+                LOGGER.info("[BedrockBridge] 🟦 {} | Ping={}ms | Stability={}% | Tolerance=x{} | Lost={}",
+                    this.player.getScoreboardName(),
+                    this.latency,
+                    getConnectionStabilityScore(),
+                    this.activeMovementTolerance,
+                    packetsLost.get()
+                );
+            } else if (this.connectionType == PlayerConnectionType.JAVA_TUNNEL) {
+                LOGGER.info("[BedrockBridge] 🟩 {} (tunnel) | Ping={}ms | Stability={}% | Tolerance=x{}",
+                    this.player.getScoreboardName(),
+                    this.latency,
+                    getConnectionStabilityScore(),
+                    this.activeMovementTolerance
+                );
+            }
+        }
+        // VoltPur end
+    }
+    
+    // VoltPur start - Bedrock Bridge: اختيار ملف QoS المناسب
+    private ConnectionProfile getActiveProfile() {
+        if (this.player == null) return ConnectionProfile.JAVA_DIRECT;
+        
+        // تحديث نوع الاتصال بشكل دوري
+        refreshConnectionType();
+        
+        switch (this.connectionType) {
+            case BEDROCK: return ConnectionProfile.BEDROCK;
+            case JAVA_TUNNEL: return ConnectionProfile.JAVA_TUNNEL;
+            default: return ConnectionProfile.JAVA_DIRECT;
+        }
+    }
+    
+    public double getActiveMovementTolerance() {
+        return this.activeMovementTolerance;
+    }
+    // VoltPur end
     
     @Override
     public void handleKeepAlive(ClientboundKeepAlivePacket packet) {
@@ -50,6 +_,42 @@
         if (pending != null && pending.challengeId() == packet.getId()) {
             this.keepAlive.pendingKeepAlives.remove(pending);
             this.latency = (int) (System.nanoTime() - pending.sendTimeNanos()) / 1000000L;
+            
+            // VoltPur start - Bedrock Bridge: تحليل جودة الاتصال
+            this.packetsReceived.incrementAndGet();
+            this.consecutiveFailures = 0;
+            
+            // تسجيل الـ latency في التاريخ
+            this.latencyHistoryMs.offer((long) this.latency);
+            while (this.latencyHistoryMs.size() > LATENCY_SAMPLE_SIZE) {
+                this.latencyHistoryMs.poll();
+            }
+            
+            // كشف Bedrock من خلال ارتفاع الـ ping المستمر
+            if (this.tickCounter > TICKS_BEFORE_STABLE && this.connectionType == PlayerConnectionType.JAVA_DIRECT) {
+                double avgLatency = this.latencyHistoryMs.stream()
+                    .mapToLong(Long::longValue).average().orElse(0);
+                if (avgLatency > 300) {
+                    // Ping عالي جداً - يمكن أن يكون Bedrock أو tunnel
+                    if (this.clientBrand != null && (this.clientBrand.toLowerCase().contains("geyser") ||
+                        this.clientBrand.toLowerCase().contains("bedrock"))) {
+                        this.connectionType = PlayerConnectionType.BEDROCK;
+                        LOGGER.info("[BedrockBridge] 🔍 Detected Bedrock player: {} (brand={}, ping={}ms)",
+                            this.player.getScoreboardName(), this.clientBrand, (int)avgLatency);
+                    } else {
+                        this.connectionType = PlayerConnectionType.JAVA_TUNNEL;
+                        LOGGER.info("[BedrockBridge] 🔍 Detected tunnel player: {} (ping={}ms)",
+                            this.player.getScoreboardName(), (int)avgLatency);
+                    }
+                }
+            }
+            // VoltPur end
+            
             this.checkIfClosed(now);
+            
+        // VoltPur start - Bedrock Bridge: تسجيل البكتات المفقودة
+        } else {
+            this.packetsLost.incrementAndGet();
+            this.consecutiveFailures++;
+            
+            // إذا فشل الاتصال كثيراً، نخفف المتطلبات
+            if (this.consecutiveFailures > 5 && this.connectionType == PlayerConnectionType.JAVA_DIRECT) {
+                this.connectionType = PlayerConnectionType.JAVA_TUNNEL;
+                LOGGER.warn("[BedrockBridge] ⚠️ Player {} experiencing packet loss. Switching to tunnel profile.",
+                    this.player.getScoreboardName());
+            }
+            
+            // إذا فشل كثيراً جداً، نقطع برسالة مفهومة
+            if (this.consecutiveFailures > MAX_CONSECUTIVE_FAILURES) {
+                LOGGER.warn("[BedrockBridge] 🛑 Player {} exceeded max failures. Disconnecting gracefully.",
+                    this.player.getScoreboardName());
+                this.disconnect(
+                    net.minecraft.network.chat.Component.literal(
+                        "§cConnection unstable. §7Please rejoin.\n" +
+                        "§7If you're on §bBedrock§7, try rejoining after a few seconds."
+                    ),
+                    org.bukkit.event.player.PlayerKickEvent.Cause.TIMEOUT
+                );
+            }
+        }
+        // VoltPur end
+    }
+    
+    // VoltPur start - Bedrock Bridge: تحديث نوع الاتصال
+    /**
+     * يحدث نوع الاتصال بناءً على المعطيات المتاحة:
+     * - clientBrand: Geyser يرسل العلامة
+     * - ping: قياس التأخير
+     * - connection address: IP التونل
+     */
+    private void refreshConnectionType() {
+        if (this.player == null) return;
+        
+        // 1. التحقق من Floodgate API (الأدق)
+        try {
+            Class<?> floodgateAPI = Class.forName("org.geysermc.floodgate.api.FloodgateAPI");
+            java.util.UUID uuid = this.player.getUUID();
+            Object result = floodgateAPI.getMethod("isBedrockPlayer", java.util.UUID.class).invoke(null, uuid);
+            if (result instanceof Boolean && (Boolean) result) {
+                this.connectionType = PlayerConnectionType.BEDROCK;
+                return;
+            }
+        } catch (Exception e) {
+            // Floodgate مش موجود - نستخدم طرق بديلة
+        }
+        
+        // 2. التحقق من clientBrand
+        if (this.clientBrand != null && !this.clientBrand.isEmpty()) {
+            String brand = this.clientBrand.toLowerCase();
+            if (brand.contains("geyser") || brand.contains("bedrock")) {
+                this.connectionType = PlayerConnectionType.BEDROCK;
+                return;
+            }
+        }
+        
+        // 3. التحقق من اسم المستخدم (Floodgate بادئة نقطة)
+        String name = this.player.getScoreboardName();
+        if (name != null && name.startsWith(".")) {
+            this.connectionType = PlayerConnectionType.BEDROCK;
+            return;
+        }
+        
+        // 4. التحقق من عنوان الاتصال (تكنل?)
+        try {
+            java.net.SocketAddress addr = this.connection.getRemoteAddress();
+            if (addr instanceof java.net.InetSocketAddress inet) {
+                String host = inet.getHostString();
+                int port = inet.getPort();
+                if (host.contains("playit") || host.contains("ngrok") || 
+                    host.contains("tunnel") || host.startsWith("10.") ||
+                    host.startsWith("172.") || port > 50000) {
+                    this.connectionType = PlayerConnectionType.JAVA_TUNNEL;
+                    return;
+                }
+            }
+        } catch (Exception e) {
+            // تجاهل
+        }
+        
+        // 5. التحقق من متوسط ping
+        if (this.latencyHistoryMs.size() > 10) {
+            double avgLatency = this.latencyHistoryMs.stream()
+                .mapToLong(Long::longValue).average().orElse(0);
+            if (avgLatency > 300) {
+                this.connectionType = PlayerConnectionType.JAVA_TUNNEL;
+                return;
+            }
+        }
+        
+        // 6. افتراضياً: Java مباشر
+        this.connectionType = PlayerConnectionType.JAVA_DIRECT;
+    }
+
+    /**
+     * يعيد تقرير كامل عن حالة الاتصال.
+     */
+    public String getConnectionReport() {
+        String type;
+        switch (this.connectionType) {
+            case BEDROCK: type = "🟦 Bedrock (Geyser)"; break;
+            case JAVA_TUNNEL: type = "🟩 Java (Tunnel)"; break;
+            default: type = "🟩 Java (Direct)"; break;
+        }
+        
+        int stability = getConnectionStabilityScore();
+        String stabilityBar;
+        if (stability > 90) stabilityBar = "§a██████████ Excellent";
+        else if (stability > 70) stabilityBar = "§e█████░░░░░ Good";
+        else if (stability > 50) stabilityBar = "§6███░░░░░░░ Fair";
+        else stabilityBar = "§c█░░░░░░░░░ Poor";
+        
+        return String.format(
+            "§7━━━━ §bConnection Report §7━━━━\n" +
+            "§7Type: §f%s\n" +
+            "§7Ping: §f%dms\n" +
+            "§7Stability: §f%s\n" +
+            "§7Packets: §a%d §7received §c%d §7lost\n" +
+            "§7Tolerance: §fx%.1f\n" +
+            "§7Timeout: §f%dms\n" +
+            "§7━━━━━━━━━━━━━━━━━━━",
+            type, this.latency, stabilityBar,
+            packetsReceived.get(), packetsLost.get(),
+            this.activeMovementTolerance, this.activeTimeout
+        );
+    }
+    // VoltPur end
 }

