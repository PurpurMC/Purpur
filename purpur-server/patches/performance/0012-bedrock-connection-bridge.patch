+    // VoltPur start - Bedrock Bridge: كشف Bedrock players
+    private Boolean bedrockCache = null;
+    private long bedrockCacheTime = 0;
+    
+    @Override
+    public boolean isBedrockPlayer() {
+        // Cache لمدة دقيقة
+        long now = System.currentTimeMillis();
+        if (this.bedrockCache != null && (now - this.bedrockCacheTime) < 60000) {
+            return this.bedrockCache;
+        }
+        
+        // 1. Floodgate API (الأدق)
+        try {
+            if (FloodgateAPI.isBedrockPlayer(this.getUniqueId())) {
+                this.bedrockCache = true;
+                this.bedrockCacheTime = now;
+                return true;
+            }
+        } catch (Exception | NoClassDefFoundError e) {
+            // Floodgate مش موجود، نستخدم طرق بديلة
+        }
+        
+        // 2. Client brand (Geyser يرسل العلامة)
+        if (this.serverPlayer != null && this.serverPlayer.connection != null) {
+            String brand = this.serverPlayer.connection.clientBrand;
+            if (brand != null && (brand.toLowerCase().contains("geyser") || 
+                brand.toLowerCase().contains("bedrock"))) {
+                this.bedrockCache = true;
+                this.bedrockCacheTime = now;
+                return true;
+            }
+        }
+        
+        // 3. بادئة Floodgate في اسم المستخدم (نقطة)
+        String name = this.getName();
+        if (name != null && name.startsWith(".")) {
+            this.bedrockCache = true;
+            this.bedrockCacheTime = now;
+            return true;
+        }
+        
+        // 4. افتراضياً: Java
+        this.bedrockCache = false;
+        this.bedrockCacheTime = now;
+        return false;
+    }
