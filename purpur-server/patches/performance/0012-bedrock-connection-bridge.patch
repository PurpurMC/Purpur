     private static final long LOGIN_TIMEOUT = 30000L; // 30 ثانية
     private static final long BEDROCK_LOGIN_TIMEOUT = 60000L; // 60 ثانية للـ Bedrock
     
+    // VoltPur start - Bedrock Bridge: كشف Bedrock أثناء التسجيل
+    private boolean isBedrockLogin = false;
+    private long loginStartTime;
+    
+    /**
+     * يكشف إذا كان هذا التسجيل من Bedrock
+     * عبر فحص اسم المستخدم أو بيانات التسجيل
+     */
+    private boolean detectBedrockLogin(String username, java.net.SocketAddress address) {
+        // 1. اسم يبدأ بنقطة (Floodgate)
+        if (username != null && username.startsWith(".")) {
+            return true;
+        }
+        // 2. عنوان تونل + اسم غير معتاد
+        if (address instanceof java.net.InetSocketAddress inet) {
+            String host = inet.getHostString();
+            return host.contains("playit") || host.contains("ngrok") || host.contains("tunnel");
+        }
+        return false;
+    }
