+    public int getConnectionStabilityScore() {
+        // 0 = غير مستقر, 100 = مستقر تماماً
+        if (this.latencyHistory.isEmpty()) return 50;
+        double avgLatency = this.latencyHistory.stream().mapToLong(Long::longValue).average().orElse(0.0);
+        int timeouts = this.consecutiveTimeouts.get();
+        if (avgLatency < 100 && timeouts == 0) return 100;
+        if (avgLatency < 300 && timeouts < 3) return 75;
+        if (avgLatency < 500 && timeouts < 5) return 50;
+        return 25;
+    }
+    // VoltPur end
