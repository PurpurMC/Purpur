+        
+        // تسجيل سبب قطع الاتصال للتحليل
+        LOGGER.info("[VoltPur-Stability] Player {} disconnected. Reason: {}. Total packets lost: {}. Avg latency: {}ms",
+            this.player.getScoreboardName(),
+            reason.getString(),
+            this.totalPacketsLost.get(),
+            this.latencyHistory.stream().mapToLong(Long::longValue).average().orElse(0.0)
+        );
+        
+        // في حالة التونل، نمنع البان الفوري بسبب التايم أوت
+        if (this.isTunnelConnection && reason.getString().contains("timeout")) {
+            LOGGER.info("[VoltPur-Stability] Tunnel timeout for {}. This is normal for tunnel connections.",
+                this.player.getScoreboardName());
+        }
+        // VoltPur end
