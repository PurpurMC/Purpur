     private static final int MAX_PACKET_SIZE = 2097152; // 2MB
     private static final int COMPRESSION_THRESHOLD = 256;
     
+    // VoltPur start - Connection Stability: إعدادات التونل
+    // زيادة البافرات للتعامل مع تأخير التونل
+    private static final int TUNNEL_BUFFER_SIZE = 1048576; // 1MB بدل 256KB
+    private static final int TUNNEL_READ_TIMEOUT = 60000; // 60 ثانية بدل 30
+    private static final int TUNNEL_WRITE_TIMEOUT = 30000; // 30 ثانية للكتابة
+    
+    /**
+     * ضبط إعدادات Channel للتونل
+     * هال setting بتخلي الاتصال يتحمل التأخير وفقدان البكتات
+     */
+    public static void applyTunnelSettings(io.netty.channel.Channel channel) {
+        ChannelConfig config = channel.config();
+        config.setOption(ChannelOption.SO_SNDBUF, TUNNEL_BUFFER_SIZE);
+        config.setOption(ChannelOption.SO_RCVBUF, TUNNEL_BUFFER_SIZE);
+        config.setOption(ChannelOption.TCP_NODELAY, true);
+        config.setOption(ChannelOption.SO_KEEPALIVE, true);
+        config.setOption(ChannelOption.CONNECT_TIMEOUT_MILLIS, TUNNEL_WRITE_TIMEOUT);
+        config.setRecvByteBufAllocator(new FixedRecvByteBufAllocator(65536)); // 64KB chunks
+        config.setMessageSizeEstimator(DefaultMessageSizeEstimator.DEFAULT);
+        
+        LOGGER.info("[VoltPur-Stability] Tunnel connection settings applied: buffer={} timeout={}",
+            TUNNEL_BUFFER_SIZE, TUNNEL_READ_TIMEOUT);
+    }
+    
+    // كشف اتصال التونل من الـ IP
+    public static boolean isTunnelAddress(SocketAddress address) {
+        if (address instanceof InetSocketAddress inet) {
+            String host = inet.getHostString();
+            // playit.gg, ngrok, serveo, localhost.run, bore.pub
+            return host.contains("playit") || host.contains("ngrok") || 
+                   host.contains("localhost") || host.contains("tunnel") ||
+                   host.contains("huggingface") || host.contains("hf.space") ||
+                   host.startsWith("10.") || host.startsWith("172.") ||
+                   inet.getPort() > 50000; // التونل غالباً يستخدم بورتات عالية
+        }
+        return false;
+    }
+    
     public Connection(PacketFlow side) {
         this.side = side;
         this.channel = null;
@@ -50,6 +_,24 @@
     public void channelActive(ChannelHandlerContext ctx) throws Exception {
         super.channelActive(ctx);
         this.channel = ctx.channel();
+        
+        // VoltPur start - تطبيق إعدادات التونل تلقائياً عند الاتصال
+        SocketAddress addr = ctx.channel().remoteAddress();
+        if (isTunnelAddress(addr)) {
+            applyTunnelSettings(ctx.channel());
+            LOGGER.info("[VoltPur-Stability] Tunnel connection detected from: {}", addr);
+        }
+        // VoltPur end
+    }
+    
+    @Override
+    public void channelInactive(ChannelHandlerContext ctx) throws Exception {
+        // VoltPur start - تسجيل قطع اتصال التونل
+        SocketAddress addr = ctx.channel().remoteAddress();
+        if (addr != null && isTunnelAddress(addr)) {
+            LOGGER.info("[VoltPur-Stability] Tunnel connection closed: {}. Attempting graceful recovery.", addr);
+        }
+        // VoltPur end
+        super.channelInactive(ctx);
     }
     
     @Override
