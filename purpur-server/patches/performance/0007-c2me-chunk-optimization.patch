diff --git a/src/main/java/net/minecraft/server/level/ChunkMap.java b/src/main/java/net/minecraft/server/level/ChunkMap.java
index abc123..def456 100644
--- a/src/main/java/net/minecraft/server/level/ChunkMap.java
+++ b/src/main/java/net/minecraft/server/level/ChunkMap.java
@@ -40,6 +_,20 @@
     private static final int MAX_VIEW_DISTANCE = 32;
     private static final int CHUNK_LOAD_BUFFER = 4;
     private static final Logger LOGGER = LogUtils.getLogger();
+    
+    // VoltPur start - C2ME-style: تحسين تحميل الكانكس
+    private static final int MAX_CHUNKS_PER_TICK = 10;
+    private static final int MAX_CHUNKS_TO_LOAD = 50;
+    private int chunksLoadedThisTick = 0;
+    private final java.util.Queue<ChunkPos> pendingChunks = new java.util.ArrayDeque<>();
+    
+    public boolean canLoadChunk() {
+        if (chunksLoadedThisTick >= MAX_CHUNKS_PER_TICK) {
+            return false;
+        }
+        chunksLoadedThisTick++;
+        return true;
+    }
 
     private final LevelHeightAccessor heightAccessor;
     private final Level level;
@@ -180,6 +_,16 @@
 
     @Override
     public void tick() {
+        // VoltPur start - تحسين: تحميل الكانكس تدريجياً
+        this.chunksLoadedThisTick = 0;
+        int loaded = 0;
+        while (!pendingChunks.isEmpty() && loaded < MAX_CHUNKS_PER_TICK && canLoadChunk()) {
+            ChunkPos pos = pendingChunks.poll();
+            if (pos != null) {
+                this.getChunk(pos.x, pos.z, ChunkStatus.FULL, true);
+                loaded++;
+            }
+        }
         super.tick();
         // المنطق الأساسي
         if (this.updatingChunks.isEmpty()) {
@@ -220,6 +_,17 @@
                 this.entityMap.remove(entity.getId());
             }
         }
+        
+        // VoltPur start - تحسين: تقليل عدد الكانكس المحملة
+        if (this.chunks.size() > this.viewDistance * this.viewDistance * 2) {
+            Iterator<ChunkHolder> it = this.chunks.values().iterator();
+            int toRemove = this.chunks.size() - (this.viewDistance * this.viewDistance);
+            while (it.hasNext() && toRemove > 0) {
+                ChunkHolder holder = it.next();
+                if (!holder.isCurrentlyLoaded()) {
+                    it.remove();
+                    toRemove--;
+                }
+            }
+        }
+        // VoltPur end
     }
 
