@@ -320,6 +_,15 @@
         if (!this.level.getServer().isSameThread() && !this.isChunkInRange(pos)) {
             return null;
         }
+        
+        // VoltPur start - تحسين: عدم تحميل الكانكس البعيدة جداً
+        if (!this.isChunkInRange(pos)) {
+            if (pendingChunks.size() < MAX_CHUNKS_TO_LOAD) {
