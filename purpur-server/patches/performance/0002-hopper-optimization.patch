From: VoltPur Performance
Date: Mon, 28 Jul 2026
Subject: [PATCH] تحسين أداء Hopper - تقليل حسابات الهوبر غير الضرورية
---
مشكلة الهوبر: الهوبرات بتعمل check كل tick حتى لو فاضية، ده بيسبب lag كبير في السيرفرات الكبيرة.
الحل: الهوبر الفاضي ينام (sleep) لمدة 20 tick قبل ما يعيد check تاني.

diff --git a/src/main/java/net/minecraft/world/level/block/entity/HopperBlockEntity.java b/src/main/java/net/minecraft/world/level/block/entity/HopperBlockEntity.java
index xyz789..abc012 100644
--- a/src/main/java/net/minecraft/world/level/block/entity/HopperBlockEntity.java
+++ b/src/main/java/net/minecraft/world/level/block/entity/HopperBlockEntity.java
@@ -45,6 +45,9 @@ public class HopperBlockEntity extends RandomizableContainerBlockEntity {
     private long nextTickTime;
     private long tickedGameTime;
     private boolean isPowered;
+    // VoltPur start - هوبر فاضي ينام
+    private int emptyCooldown = 0;
+    // VoltPur end
     
     public HopperBlockEntity(BlockPos pos, BlockState state) {
         super(BlockEntityType.HOPPER, pos, state);
@@ -120,6 +123,17 @@ public class HopperBlockEntity extends RandomizableContainerBlockEntity {
         // VoltPur start - تحسين أداء الهوبر الفاضي
+        if (this.isEmpty()) {
+            this.emptyCooldown++;
+            if (this.emptyCooldown < 20) { // 20 tick = 1 ثانية
+                return;
+            }
+        }
+        this.emptyCooldown = 0;
         // لو الهوبر فاضي، ما يعملش check إلا كل 20 tick بدل كل tick
         // VoltPur end
         
         if (!this.isPowered && !this.isOnTransferCooldown()) {
