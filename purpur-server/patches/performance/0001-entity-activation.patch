From: VoltPur Performance
Date: Mon, 28 Jul 2026
Subject: [PATCH] تحسين أداء Entity Activation - تفعيل ذكي للكائنات
---
diff --git a/src/main/java/net/minecraft/server/level/ServerChunkCache.java b/src/main/java/net/minecraft/server/level/ServerChunkCache.java
index abc123..def456 100644
--- a/src/main/java/net/minecraft/server/level/ServerChunkCache.java
+++ b/src/main/java/net/minecraft/server/level/ServerChunkCache.java
@@ -250,6 +250,16 @@ public class ServerChunkCache extends ChunkGenerator implements java.io.Closeabl
         // VoltPur start - تحسين أداء Entity Activation
         // بدل ما نعمل tick لكل الكائنات، نشغل الكائنات القريبة بس
+        if (entity.distanceToSqr(player) > 128 * 128) {
+            // الكائنات البعيدة: tick أبطأ (كل 20 tick بدل كل tick)
+            if (entity.tickCount % 20 != 0) {
+                return;
+            }
+        } else if (entity.distanceToSqr(player) > 32 * 32) {
+            // الكائنات المتوسطة: tick أبطأ (كل 5 tick)
+            if (entity.tickCount % 5 != 0) {
+                return;
+            }
+        }
         // VoltPur end
     }
 }
