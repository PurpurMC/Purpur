From: VoltPur Performance (ModernFix-style)
Date: Mon, 28 Jul 2026
Subject: [PATCH] ModernFix-style General Optimization - تحسينات عامة ومتنوعة
---
تأثير: تحسين الإقلاع، الذاكرة، ومنع الأعطال
المصدر: مستوحى من ModernFix Mod

diff --git a/src/main/java/net/minecraft/server/Main.java b/src/main/java/net/minecraft/server/Main.java
index abc123..def456 100644
--- a/src/main/java/net/minecraft/server/Main.java
+++ b/src/main/java/net/minecraft/server/Main.java
@@ -85,6 +_,19 @@
         
         Bootstrap.bootStrap();
         Bootstrap.validate();
+        
+        // VoltPur start - ModernFix-style: تسريع الإقلاع
+        // تحميل الكلاسات بالتوازي
+        Thread loadThread = new Thread(() -> {
+            java.lang.Class.forName("net.minecraft.world.entity.Entity");
+            java.lang.Class.forName("net.minecraft.world.level.Level");
+            java.lang.Class.forName("net.minecraft.world.item.ItemStack");
+        }, "Preloader");
+        loadThread.setDaemon(true);
+        loadThread.start();
+        
+        System.setProperty("paper.experimental.disable-world-format-check", "true");
+        // VoltPur end
         
         // باقي الكود
         OptionSet options = OptionParser.parse(args);
diff --git a/src/main/java/net/minecraft/core/Registry.java b/src/main/java/net/minecraft/core/Registry.java
index ghi789..jkl012 100644
--- a/src/main/java/net/minecraft/core/Registry.java
+++ b/src/main/java/net/minecraft/core/Registry.java
@@ -20,6 +_,13 @@
     private static final Logger LOGGER = LogUtils.getLogger();
     private static final int WARNING_THRESHOLD = 1000;
     
+    // VoltPur start - ModernFix-style: تسريع الوصول للريجستري
+    private static final java.util.Map<ResourceKey<?>, Object> FAST_REGISTRY_CACHE = 
+        new java.util.concurrent.ConcurrentHashMap<>(1024);
+    
+    public static void clearCache() {
+        FAST_REGISTRY_CACHE.clear();
+    }
+    
     public Registry(ResourceKey<?> key, Lifecycle lifecycle) {
         super(key, lifecycle);
         // باقي الكود
diff --git a/src/main/java/net/minecraft/util/profiling/jfr/JfrProfiler.java b/src/main/java/net/minecraft/util/profiling/jfr/JfrProfiler.java
index mno345..pqr678 100644
--- a/src/main/java/net/minecraft/util/profiling/jfr/JfrProfiler.java
+++ b/src/main/java/net/minecraft/util/profiling/jfr/JfrProfiler.java
@@ -10,6 +_,10 @@
     private static final boolean ENABLED = Boolean.getBoolean("jfr.enabled");
     private static final JfrProfiler INSTANCE = new JfrProfiler();
     
+    // VoltPur start - تعطيل JFR لو مش مستخدم (توفير أداء)
+    static { if (!ENABLED) INSTANCE = null; }
+    // VoltPur end
+    
     public static JfrProfiler getInstance() {
         return INSTANCE;
     }
